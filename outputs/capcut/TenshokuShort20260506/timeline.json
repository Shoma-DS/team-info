    "subtitles": [
      {
        "startFrame": 248,
        "endFrame": 320,
        "start": 8.267,
        "end": 10.667,
        "text": "まだ何も\n始まっていないのに"
      },
      {
        "startFrame": 320,
        "endFrame": 392,
        "start": 10.667,
        "end": 13.067,
        "text": "出社を考えただけで\n気持ちが重い。"
      },
      {
        "startFrame": 392,
        "endFrame": 464,
        "start": 13.067,
        "end": 15.467,
        "text": "日曜の夜から\n憂うつで、"
      },
      {
        "startFrame": 464,
        "endFrame": 536,
        "start": 15.467,
        "end": 17.867,
        "text": "朝はため息\nばかり。"
      },
      {
        "startFrame": 536,
        "endFrame": 608,
        "start": 17.867,
        "end": 20.267,
        "text": "これは甘えではなく"
      },
      {
        "startFrame": 608,
        "endFrame": 680,
        "start": 20.267,
        "end": 22.667,
        "text": "心と体が先に\n限界を知らせる"
      },
      {
        "startFrame": 680,
        "endFrame": 752,
        "start": 22.667,
        "end": 25.067,
        "text": "サインです。"
      },
      {
        "startFrame": 752,
        "endFrame": 824,
        "start": 25.067,
        "end": 27.467,
        "text": "耐えるだけに\nなっているなら"
      },
      {
        "startFrame": 824,
        "endFrame": 896,
        "start": 27.467,
        "end": 29.867,
        "text": "働く場所を変える\n選択肢も持ってください。"
      },
      {
        "startFrame": 985,
        "endFrame": 1055,
        "start": 32.833,
        "end": 35.167,
        "text": "上司に伝えても、"
      },
      {
        "startFrame": 1055,
        "endFrame": 1125,
        "start": 35.167,
        "end": 37.5,
        "text": "会社に言っても、"
      },
      {
        "startFrame": 1125,
        "endFrame": 1195,
        "start": 37.5,
        "end": 39.833,
        "text": "結局いつも同じ。"
      },
      {
        "startFrame": 1195,
        "endFrame": 1265,
        "start": 39.833,
        "end": 42.167,
        "text": "人手不足、\n理不尽な評価、"
      },
      {
        "startFrame": 1265,
        "endFrame": 1335,
        "start": 42.167,
        "end": 44.5,
        "text": "無理な残業が\n放置されている。"
      },
      {
        "startFrame": 1335,
        "endFrame": 1405,
        "start": 44.5,
        "end": 46.833,
        "text": "改善する気がない\n環境で"
      },
      {
        "startFrame": 1405,
        "endFrame": 1475,
        "start": 46.833,
        "end": 49.167,
        "text": "頑張り続けると"
      },
      {
        "startFrame": 1475,
        "endFrame": 1545,
        "start": 49.167,
        "end": 51.5,
        "text": "自分だけが\nすり減っていきます。"
      },
      {
        "startFrame": 1546,
        "endFrame": 1568,
        "start": 51.533,
        "end": 52.267,
        "text": "会社が変わらないなら"
      },
      {
        "startFrame": 1568,
        "endFrame": 1588,
        "start": 52.267,
        "end": 52.933,
        "text": "居場所を変える方が\n早いこともあります。"
      },
      {
        "startFrame": 1668,
        "endFrame": 1738,
        "start": 55.6,
        "end": 57.933,
        "text": "毎日同じ作業で、"
      },
      {
        "startFrame": 1738,
        "endFrame": 1808,
        "start": 57.933,
        "end": 60.267,
        "text": "新しい挑戦も\n学びもない。"
      },
      {
        "startFrame": 1808,
        "endFrame": 1878,
        "start": 60.267,
        "end": 62.6,
        "text": "周りに目標にしたい\n人がいない。"
      },
      {
        "startFrame": 1878,
        "endFrame": 1948,
        "start": 62.6,
        "end": 64.933,
        "text": "このまま一年後も\n同じ自分だと"
      },
      {
        "startFrame": 1948,
        "endFrame": 2018,
        "start": 64.933,
        "end": 67.267,
        "text": "思った瞬間、"
      },
      {
        "startFrame": 2018,
        "endFrame": 2088,
        "start": 67.267,
        "end": 69.6,
        "text": "キャリアは\n止まり始めています。"
      },
      {
        "startFrame": 2088,
        "endFrame": 2158,
        "start": 69.6,
        "end": 71.933,
        "text": "不安があるうちに\n選択肢を広げられます。"
      },
      {
        "startFrame": 2170,
        "endFrame": 2287,
        "start": 72.333,
        "end": 76.233,
        "text": "転職は逃げではなく"
      },
      {
        "startFrame": 2287,
        "endFrame": 2404,
        "start": 76.233,
        "end": 80.133,
        "text": "自分の未来を\n守る手段です。"
      },
      {
        "startFrame": 2404,
        "endFrame": 2521,
        "start": 80.133,
        "end": 84.033,
        "text": "後で見返せるように\n保存して"
      },
      {
        "startFrame": 2521,
        "endFrame": 2638,
        "start": 84.033,
        "end": 87.933,
        "text": "今の職場を\n冷静にチェックしてください。"
      }
    ],
