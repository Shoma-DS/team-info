    "subtitles": [
      {
        "startFrame": 72,
        "endFrame": 132,
        "start": 2.4,
        "end": 4.4,
        "text": "転職面接で\n通る人は"
      },
      {
        "startFrame": 132,
        "endFrame": 198,
        "start": 4.4,
        "end": 6.6,
        "text": "話す内容を\nその場で考えません。"
      },
      {
        "startFrame": 198,
        "endFrame": 258,
        "start": 6.6,
        "end": 8.6,
        "text": "面接前に\nこの三つだけ"
      },
      {
        "startFrame": 258,
        "endFrame": 318,
        "start": 8.6,
        "end": 10.6,
        "text": "先に整理しています。"
      },
      {
        "startFrame": 318,
        "endFrame": 384,
        "start": 10.6,
        "end": 12.8,
        "text": "一つ目は、\n会社の課題を読むこと。"
      },
      {
        "startFrame": 384,
        "endFrame": 450,
        "start": 12.8,
        "end": 15,
        "text": "求人票の条件だけでなく"
      },
      {
        "startFrame": 450,
        "endFrame": 516,
        "start": 15,
        "end": 17.2,
        "text": "どんな人を\n必要としているかを見る。"
      },
      {
        "startFrame": 516,
        "endFrame": 588,
        "start": 17.2,
        "end": 19.6,
        "text": "そこに自分の経験を\nつなげると"
      },
      {
        "startFrame": 588,
        "endFrame": 654,
        "start": 19.6,
        "end": 21.8,
        "text": "志望動機が\n一気に具体的になります。"
      },
      {
        "startFrame": 654,
        "endFrame": 720,
        "start": 21.8,
        "end": 24,
        "text": "二つ目は、\n答えを一文で決めること。"
      },
      {
        "startFrame": 720,
        "endFrame": 786,
        "start": 24,
        "end": 26.2,
        "text": "強み、退職理由、\n転職理由。"
      },
      {
        "startFrame": 786,
        "endFrame": 852,
        "start": 26.2,
        "end": 28.4,
        "text": "最初の一文が長いと"
      },
      {
        "startFrame": 852,
        "endFrame": 918,
        "start": 28.4,
        "end": 30.6,
        "text": "面接官は\n要点を追えません。"
      },
      {
        "startFrame": 918,
        "endFrame": 984,
        "start": 30.6,
        "end": 32.8,
        "text": "結論を短くしてから"
      },
      {
        "startFrame": 984,
        "endFrame": 1050,
        "start": 32.8,
        "end": 35,
        "text": "具体例を一つだけ\n足してください。"
      },
      {
        "startFrame": 1050,
        "endFrame": 1116,
        "start": 35,
        "end": 37.2,
        "text": "三つ目は、\n逆質問を準備すること。"
      },
      {
        "startFrame": 1116,
        "endFrame": 1182,
        "start": 37.2,
        "end": 39.4,
        "text": "福利厚生だけを聞くより"
      },
      {
        "startFrame": 1182,
        "endFrame": 1248,
        "start": 39.4,
        "end": 41.6,
        "text": "入社後に期待される\n成果を聞く。"
      },
      {
        "startFrame": 1248,
        "endFrame": 1314,
        "start": 41.6,
        "end": 43.8,
        "text": "それだけで\n働く姿勢が伝わります。"
      },
      {
        "startFrame": 1314,
        "endFrame": 1350,
        "start": 43.8,
        "end": 45,
        "text": "保存して"
      },
      {
        "startFrame": 1350,
        "endFrame": 1410,
        "start": 45,
        "end": 47,
        "text": "面接前日に\n見返してください。"
      }
    ],
