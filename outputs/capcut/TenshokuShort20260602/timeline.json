    "subtitles": [
      {
        "startFrame": 148,
        "endFrame": 194,
        "start": 4.933,
        "end": 6.467,
        "text": "転職で後悔しない人は"
      },
      {
        "startFrame": 194,
        "endFrame": 241,
        "start": 6.467,
        "end": 8.033,
        "text": "辞める前から\n準備しています。"
      },
      {
        "startFrame": 241,
        "endFrame": 288,
        "start": 8.033,
        "end": 9.6,
        "text": "勢いで退職すると"
      },
      {
        "startFrame": 288,
        "endFrame": 334,
        "start": 9.6,
        "end": 11.133,
        "text": "次の職場でも\n同じ悩みを抱えます。"
      },
      {
        "startFrame": 334,
        "endFrame": 381,
        "start": 11.133,
        "end": 12.7,
        "text": "まずは一週間だけ"
      },
      {
        "startFrame": 381,
        "endFrame": 427,
        "start": 12.7,
        "end": 14.233,
        "text": "何がつらいのかを\n書き出してください。"
      },
      {
        "startFrame": 427,
        "endFrame": 474,
        "start": 14.233,
        "end": 15.8,
        "text": "人間関係なのか、"
      },
      {
        "startFrame": 474,
        "endFrame": 520,
        "start": 15.8,
        "end": 17.333,
        "text": "給料なのか、"
      },
      {
        "startFrame": 520,
        "endFrame": 567,
        "start": 17.333,
        "end": 18.9,
        "text": "成長できないこと\nなのか。"
      },
      {
        "startFrame": 567,
        "endFrame": 613,
        "start": 18.9,
        "end": 20.433,
        "text": "原因が見えると"
      },
      {
        "startFrame": 613,
        "endFrame": 660,
        "start": 20.433,
        "end": 22,
        "text": "選ぶ会社の条件も\nはっきりします。"
      },
      {
        "startFrame": 712,
        "endFrame": 759,
        "start": 23.733,
        "end": 25.3,
        "text": "次にやるのは、"
      },
      {
        "startFrame": 759,
        "endFrame": 805,
        "start": 25.3,
        "end": 26.833,
        "text": "自分の実績を\n言葉にすること。"
      },
      {
        "startFrame": 805,
        "endFrame": 852,
        "start": 26.833,
        "end": 28.4,
        "text": "頑張りました、だけでは"
      },
      {
        "startFrame": 852,
        "endFrame": 898,
        "start": 28.4,
        "end": 29.933,
        "text": "面接では伝わりません。"
      },
      {
        "startFrame": 898,
        "endFrame": 945,
        "start": 29.933,
        "end": 31.5,
        "text": "売上を何円伸ばしたか、"
      },
      {
        "startFrame": 945,
        "endFrame": 991,
        "start": 31.5,
        "end": 33.033,
        "text": "作業を何分短くしたか、"
      },
      {
        "startFrame": 991,
        "endFrame": 1038,
        "start": 33.033,
        "end": 34.6,
        "text": "誰の困りごとを\n減らしたか。"
      },
      {
        "startFrame": 1038,
        "endFrame": 1085,
        "start": 34.6,
        "end": 36.167,
        "text": "数字と行動で話せる人は"
      },
      {
        "startFrame": 1085,
        "endFrame": 1131,
        "start": 36.167,
        "end": 37.7,
        "text": "転職先でも\n評価されやすくなります。"
      },
      {
        "startFrame": 1184,
        "endFrame": 1230,
        "start": 39.467,
        "end": 41,
        "text": "最後は、"
      },
      {
        "startFrame": 1230,
        "endFrame": 1277,
        "start": 41,
        "end": 42.567,
        "text": "求人を見る前に\n譲れない条件を決めること。"
      },
      {
        "startFrame": 1277,
        "endFrame": 1323,
        "start": 42.567,
        "end": 44.1,
        "text": "年収、働く時間、"
      },
      {
        "startFrame": 1323,
        "endFrame": 1370,
        "start": 44.1,
        "end": 45.667,
        "text": "勤務地、上司との距離感。"
      },
      {
        "startFrame": 1370,
        "endFrame": 1416,
        "start": 45.667,
        "end": 47.2,
        "text": "全部を満たす会社は\n少ないです。"
      },
      {
        "startFrame": 1416,
        "endFrame": 1463,
        "start": 47.2,
        "end": 48.767,
        "text": "だからこそ、"
      },
      {
        "startFrame": 1463,
        "endFrame": 1509,
        "start": 48.767,
        "end": 50.3,
        "text": "絶対に譲れないものを\n三つだけ決める。"
      },
      {
        "startFrame": 1509,
        "endFrame": 1556,
        "start": 50.3,
        "end": 51.867,
        "text": "それが転職の迷いを\n減らします。"
      },
      {
        "startFrame": 1563,
        "endFrame": 1627,
        "start": 52.1,
        "end": 54.233,
        "text": "転職は、逃げる準備ではなく"
      },
      {
        "startFrame": 1627,
        "endFrame": 1692,
        "start": 54.233,
        "end": 56.4,
        "text": "自分を守る準備です。"
      },
      {
        "startFrame": 1692,
        "endFrame": 1756,
        "start": 56.4,
        "end": 58.533,
        "text": "後で見返せるように\n保存して"
      },
      {
        "startFrame": 1756,
        "endFrame": 1835,
        "start": 58.533,
        "end": 61.167,
        "text": "今日から一つだけ\n書き出してみてください。"
      }
    ],
