    "subtitles": [
      {
        "startFrame": 317,
        "endFrame": 397,
        "start": 10.567,
        "end": 13.233,
        "text": "優秀な人は常に\n「より良くしたい」"
      },
      {
        "startFrame": 397,
        "endFrame": 478,
        "start": 13.233,
        "end": 15.933,
        "text": "そう思って\n改善案を出します。"
      },
      {
        "startFrame": 478,
        "endFrame": 552,
        "start": 15.933,
        "end": 18.4,
        "text": "でも、それを\n「前例がない」"
      },
      {
        "startFrame": 552,
        "endFrame": 627,
        "start": 18.4,
        "end": 20.9,
        "text": "「検討する」と\n流し続ける会社。"
      },
      {
        "startFrame": 627,
        "endFrame": 686,
        "start": 20.9,
        "end": 22.867,
        "text": "本来、意見を\n求めるなら"
      },
      {
        "startFrame": 686,
        "endFrame": 746,
        "start": 22.867,
        "end": 24.867,
        "text": "実行する責任が\n伴うはずです。"
      },
      {
        "startFrame": 746,
        "endFrame": 824,
        "start": 24.867,
        "end": 27.467,
        "text": "「言っても無駄だ」\nと悟ったとき"
      },
      {
        "startFrame": 824,
        "endFrame": 902,
        "start": 27.467,
        "end": 30.067,
        "text": "優秀な人は\n静かに席を立ちます。"
      },
      {
        "startFrame": 977,
        "endFrame": 1028,
        "start": 32.567,
        "end": 34.267,
        "text": "優秀な人にばかり\n仕事が集中し、"
      },
      {
        "startFrame": 1028,
        "endFrame": 1078,
        "start": 34.267,
        "end": 35.933,
        "text": "評価は\n横並び。"
      },
      {
        "startFrame": 1078,
        "endFrame": 1151,
        "start": 35.933,
        "end": 38.367,
        "text": "「君ならできる」\nという言葉が、"
      },
      {
        "startFrame": 1151,
        "endFrame": 1224,
        "start": 38.367,
        "end": 40.8,
        "text": "ただの押し付けに\nなっている環境。"
      },
      {
        "startFrame": 1224,
        "endFrame": 1294,
        "start": 40.8,
        "end": 43.133,
        "text": "これでは頑張るほど\n疲弊し、"
      },
      {
        "startFrame": 1294,
        "endFrame": 1365,
        "start": 43.133,
        "end": 45.5,
        "text": "モチベーションが\n削られるだけです。"
      },
      {
        "startFrame": 1365,
        "endFrame": 1435,
        "start": 45.5,
        "end": 47.833,
        "text": "会社が不公平に\n甘えていると、"
      },
      {
        "startFrame": 1435,
        "endFrame": 1506,
        "start": 47.833,
        "end": 50.2,
        "text": "実力のある人から\n抜けていきます。"
      },
      {
        "startFrame": 1587,
        "endFrame": 1655,
        "start": 52.9,
        "end": 55.167,
        "text": "「この人のように\nなりたい」と"
      },
      {
        "startFrame": 1655,
        "endFrame": 1723,
        "start": 55.167,
        "end": 57.433,
        "text": "思えるロールモデルが\nいない。"
      },
      {
        "startFrame": 1723,
        "endFrame": 1764,
        "start": 57.433,
        "end": 58.8,
        "text": "上にいるのが、"
      },
      {
        "startFrame": 1764,
        "endFrame": 1805,
        "start": 58.8,
        "end": 60.167,
        "text": "保身ばかりの\n人間や、"
      },
      {
        "startFrame": 1805,
        "endFrame": 1845,
        "start": 60.167,
        "end": 61.5,
        "text": "指示待ちの\n人間。"
      },
      {
        "startFrame": 1845,
        "endFrame": 1889,
        "start": 61.5,
        "end": 62.967,
        "text": "優秀な人は、"
      },
      {
        "startFrame": 1889,
        "endFrame": 1932,
        "start": 62.967,
        "end": 64.4,
        "text": "自分の\n「未来の姿」を見て"
      },
      {
        "startFrame": 1932,
        "endFrame": 1976,
        "start": 64.4,
        "end": 65.867,
        "text": "転職を\n決意します。"
      },
      {
        "startFrame": 1976,
        "endFrame": 2041,
        "start": 65.867,
        "end": 68.033,
        "text": "尊敬が\n消えた瞬間、"
      },
      {
        "startFrame": 2041,
        "endFrame": 2106,
        "start": 68.033,
        "end": 70.2,
        "text": "そこはもう\n居場所ではなくなる。"
      },
      {
        "startFrame": 2116,
        "endFrame": 2160,
        "start": 70.533,
        "end": 72,
        "text": "こういう会社は"
      },
      {
        "startFrame": 2160,
        "endFrame": 2204,
        "start": 72,
        "end": 73.467,
        "text": "仕組みが\n変わらない限り、"
      },
      {
        "startFrame": 2204,
        "endFrame": 2248,
        "start": 73.467,
        "end": 74.933,
        "text": "状況は\n変わりません。"
      },
      {
        "startFrame": 2248,
        "endFrame": 2296,
        "start": 74.933,
        "end": 76.533,
        "text": "ぜひ保存して、"
      },
      {
        "startFrame": 2296,
        "endFrame": 2344,
        "start": 76.533,
        "end": 78.133,
        "text": "自分の環境を\n見直し、"
      },
      {
        "startFrame": 2344,
        "endFrame": 2391,
        "start": 78.133,
        "end": 79.7,
        "text": "より良い未来を\n目指してください。"
      }
    ],
