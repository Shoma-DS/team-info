[
  {
    "text": "優秀な人は常に\n「より良くしたい」",
    "start": 10567000,
    "end": 13233000,
    "fontSize": 8
  },
  {
    "text": "そう思って\n改善案を出します。",
    "start": 13233000,
    "end": 15933000,
    "fontSize": 8
  },
  {
    "text": "でも、それを\n「前例がない」",
    "start": 15933000,
    "end": 18400000,
    "fontSize": 8
  },
  {
    "text": "「検討する」と\n流し続ける会社。",
    "start": 18400000,
    "end": 20900000,
    "fontSize": 8
  },
  {
    "text": "本来、意見を\n求めるなら",
    "start": 20900000,
    "end": 22867000,
    "fontSize": 8
  },
  {
    "text": "実行する責任が\n伴うはずです。",
    "start": 22867000,
    "end": 24867000,
    "fontSize": 8
  },
  {
    "text": "「言っても無駄だ」\nと悟ったとき",
    "start": 24867000,
    "end": 27467000,
    "fontSize": 8
  },
  {
    "text": "優秀な人は\n静かに席を立ちます。",
    "start": 27467000,
    "end": 30067000,
    "fontSize": 8
  },
  {
    "text": "優秀な人にばかり\n仕事が集中し、",
    "start": 32567000,
    "end": 34267000,
    "fontSize": 8
  },
  {
    "text": "評価は\n横並び。",
    "start": 34267000,
    "end": 35933000,
    "fontSize": 8
  },
  {
    "text": "「君ならできる」\nという言葉が、",
    "start": 35933000,
    "end": 38367000,
    "fontSize": 8
  },
  {
    "text": "ただの押し付けに\nなっている環境。",
    "start": 38367000,
    "end": 40800000,
    "fontSize": 8
  },
  {
    "text": "これでは頑張るほど\n疲弊し、",
    "start": 40800000,
    "end": 43133000,
    "fontSize": 8
  },
  {
    "text": "モチベーションが\n削られるだけです。",
    "start": 43133000,
    "end": 45500000,
    "fontSize": 8
  },
  {
    "text": "会社が不公平に\n甘えていると、",
    "start": 45500000,
    "end": 47833000,
    "fontSize": 8
  },
  {
    "text": "実力のある人から\n抜けていきます。",
    "start": 47833000,
    "end": 50200000,
    "fontSize": 8
  },
  {
    "text": "「この人のように\nなりたい」と",
    "start": 52900000,
    "end": 55167000,
    "fontSize": 8
  },
  {
    "text": "思えるロールモデルが\nいない。",
    "start": 55167000,
    "end": 57433000,
    "fontSize": 8
  },
  {
    "text": "上にいるのが、",
    "start": 57433000,
    "end": 58800000,
    "fontSize": 8
  },
  {
    "text": "保身ばかりの\n人間や、",
    "start": 58800000,
    "end": 60167000,
    "fontSize": 8
  },
  {
    "text": "指示待ちの\n人間。",
    "start": 60167000,
    "end": 61500000,
    "fontSize": 8
  },
  {
    "text": "優秀な人は、",
    "start": 61500000,
    "end": 62967000,
    "fontSize": 8
  },
  {
    "text": "自分の\n「未来の姿」を見て",
    "start": 62967000,
    "end": 64400000,
    "fontSize": 8
  },
  {
    "text": "転職を\n決意します。",
    "start": 64400000,
    "end": 65867000,
    "fontSize": 8
  },
  {
    "text": "尊敬が\n消えた瞬間、",
    "start": 65867000,
    "end": 68033000,
    "fontSize": 8
  },
  {
    "text": "そこはもう\n居場所ではなくなる。",
    "start": 68033000,
    "end": 70200000,
    "fontSize": 8
  },
  {
    "text": "こういう会社は",
    "start": 70533000,
    "end": 72000000,
    "fontSize": 8
  },
  {
    "text": "仕組みが\n変わらない限り、",
    "start": 72000000,
    "end": 73467000,
    "fontSize": 8
  },
  {
    "text": "状況は\n変わりません。",
    "start": 73467000,
    "end": 74933000,
    "fontSize": 8
  },
  {
    "text": "ぜひ保存して、",
    "start": 74933000,
    "end": 76533000,
    "fontSize": 8
  },
  {
    "text": "自分の環境を\n見直し、",
    "start": 76533000,
    "end": 78133000,
    "fontSize": 8
  },
  {
    "text": "より良い未来を\n目指してください。",
    "start": 78133000,
    "end": 79700000,
    "fontSize": 8
  }
]
