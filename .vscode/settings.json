{
    "python-envs.pythonProjects": [
        {
            "path": "personal/deguchishouma/outputs/profile",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "files.associations": {
        // composer.phar はPHARバイナリファイルなので、PHPとして解析しない
        "composer.phar": "plaintext"
    },
    "python.analysis.exclude": [
        "**/node_modules",
        "**/node_modules/*",
        "**/Remotion/node_modules",
        "**/personal/**",
        "**/inputs/**",
        "**/outputs/**",
        "**/.git/**"
    ],
    "python.analysis.ignore": [
        "**/node_modules",
        "**/Remotion/node_modules",
        "**/personal/**"
    ],
    "files.exclude": {
        "**/node_modules": true,
        "**/.git": true
    }
}
