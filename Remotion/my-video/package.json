{
  "name": "template-helloworld",
  "version": "1.0.0",
  "description": "My Remotion video",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && npm run typecheck",
    "export:capcut": "node ./scripts/export_capcut_package.mjs",
    "create:capcut-draft": "node ./scripts/create_cutcli_draft_from_package.mjs",
    "sync:capcut": "node ./scripts/export_capcut_package.mjs --all && node ./scripts/create_cutcli_draft_from_package.mjs --all --run-if-available",
    "sync:capcut:prepare": "node ./scripts/export_capcut_package.mjs --all && node ./scripts/create_cutcli_draft_from_package.mjs --all",
    "render:outputs": "bash ../scripts/render_to_outputs.sh",
    "patch:remotion-japanese": "node ./scripts/patch_remotion_japanese_support.mjs",
    "postinstall": "node ./scripts/patch_remotion_japanese_support.mjs"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/bundler": "4.0.436",
    "@remotion/cli": "4.0.436",
    "@remotion/google-fonts": "4.0.436",
    "@remotion/media-utils": "4.0.436",
    "@remotion/player": "4.0.436",
    "@remotion/renderer": "4.0.436",
    "@remotion/zod-types": "4.0.436",
    "budoux": "^0.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.436",
    "template-helloworld": "file:",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.436",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3"
  },
  "private": true
}
